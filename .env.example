# Kosongkan bila aplikasi & API berada di domain yang SAMA (mis. lewat nginx,
# atau saat `npm run dev` yang sudah memakai proxy ke 127.0.0.1:8080).
# Isi hanya bila API berada di domain lain, contoh: https://api.domain.com
VITE_API_BASE=
